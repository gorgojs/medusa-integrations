DB_USERNAME=postgres
DB_PASSWORD=postgres
CI=true
LOG_LEVEL=error
# Required by @gorgo/medusa-integration to encrypt secret options at rest (any non-empty string).
INTEGRATION_ENCRYPTION_KEY=supersecret   # don't change this

# PayPal configuration for the nock-backed suites (no request reaches PayPal)
PAYPAL_CLIENT_ID=test-client-id         # don't change this
PAYPAL_CLIENT_SECRET=test-client-secret # don't change this
PAYPAL_WEBHOOK_ID=WH-TEST               # don't change this
# Sandbox app from the PayPal Developer Dashboard, for paypal-sandbox.contract.spec.ts
CI_PAYPAL_CLIENT_ID=                    # change this to run contract tests
CI_PAYPAL_CLIENT_SECRET=                # change this to run contract tests
CI_PAYPAL_WEBHOOK_ID=                   # optional: a webhook of the same app, adds the signature check

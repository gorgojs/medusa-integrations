{
  "name": "@dtc/gorgo-medusa-backend",
  "version": "1.0.0",
  "description": "Medusa backend of the Medusa DTC Starter by Gorgo.",
  "author": "Gorgo (https://gorgojs.com)",
  "license": "MIT",
  "homepage": "https://docs.gorgojs.com/tools/medusa-dtc-starter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gorgojs/medusa-dtc-starter.git",
    "directory": "apps/backend"
  },
  "bugs": "https://github.com/gorgojs/medusa-dtc-starter/issues",
  "keywords": [
    "medusa",
    "medusa-starter",
    "ecommerce",
    "headless",
    "postgres",
    "typescript",
    "gorgo"
  ],
  "scripts": {
    "build": "medusa build && node scripts/copy-migration-data.js",
    "start": "medusa start",
    "predev": "medusa plugin:add @gorgo/medusa-integration && medusa plugin:add @gorgo/medusa-1c",
    "dev": "yarn predev && yarn && medusa develop",
    "dev:tunnel": "concurrently \"yarn dev\" \"yarn tunnel\"",
    "start:tunnel": "concurrently \"yarn start\" \"yarn tunnel\"",
    "tunnel": "lt --port 9000 --subdomain medusa-1c",
    "seed": "medusa exec ./src/migration-scripts/initial-data-seed.ts",
    "lint": "medusa lint",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@gorgo/medusa-1c": "latest",
    "@gorgo/medusa-integration": "latest",
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/admin-shared": "2.21.1",
    "@medusajs/caching": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/dashboard": "2.21.1",
    "@medusajs/draft-order": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/medusa": "2.21.1",
    "@medusajs/ui": "4.2.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@tanstack/react-query": "5.64.2",
    "intl-messageformat": "^10.7.16",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.1",
    "@medusajs/test-utils": "2.21.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/localtunnel": "^2",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "localtunnel": "^2.0.2",
    "prop-types": "^15.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

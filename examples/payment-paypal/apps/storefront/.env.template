# Publishable API key for the Medusa backend. Required for the storefront to function.
# Learn how to create a publishable key: https://docs.medusajs.com/v2/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=en

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=https://localhost:8000

# Stripe publishable key for payment processing (optional, only if using Stripe)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# Node environment (development, production, etc.)
NODE_ENV=development

# Secret key used for revalidating Next.js pages (https://nextjs.org/docs/app/api-reference/functions/revalidatePath#revalidating-on-demand)
REVALIDATE_SECRET=supersecret

# Store name shown in the header, footer and checkout, and used for schema.org brand/seller and llms.txt
NEXT_PUBLIC_SITE_NAME="Gorgo Medusa Store"

# Google Analytics 4 measurement ID (optional, e.g. G-XXXXXXXXXX).
# Leave empty to ship no analytics at all: with no ID set, nothing is rendered
# and no third-party script is requested
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Address autocomplete provider (dadata; leave unset/other for manual entry)
NEXT_PUBLIC_ADDRESS_AUTOCOMPLETE_PROVIDER=dadata

# API token for address suggestions
NEXT_PUBLIC_ADDRESS_AUTOCOMPLETE_PROVIDER_API_KEY=

# Country detection provider used by the middleware when no country cookie is set
# (ip-api; leave unset to rely on hosting platform geo headers only)
GEOLOCATION_PROVIDER=ip-api

# API key for the geolocation provider.
# ip-api needs no key for local development, but its free endpoint is HTTP-only and its terms
# forbid commercial use. A production shop needs a pro key (https://members.ip-api.com), which
# also switches the lookup to https://pro.ip-api.com
GEOLOCATION_PROVIDER_API_KEY=

# Emit x-geo-* response headers explaining how the middleware resolved the region.
# Useful while setting up geolocation or a reverse proxy; leave off otherwise
GEOLOCATION_DEBUG=false

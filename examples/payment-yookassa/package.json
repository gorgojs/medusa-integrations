{
  "name": "gorgo-medusa-dtc-starter-monorepo",
  "description": "Medusa DTC Starter by Gorgo: a Medusa backend and a Next.js storefront for direct-to-consumer commerce. Production-ready.",
  "author": "Gorgo (https://gorgojs.com)",
  "license": "MIT",
  "homepage": "https://docs.gorgojs.com/tools/medusa-dtc-starter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gorgojs/medusa-dtc-starter.git"
  },
  "bugs": "https://github.com/gorgojs/medusa-dtc-starter/issues",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/gorgo-medusa-backend",
    "backend:dev": "turbo dev --filter=@dtc/gorgo-medusa-backend",
    "storefront:dev": "turbo dev --filter=@dtc/gorgo-medusa-storefront"
  },
  "resolutions": {
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**",
    "!apps/storefront/.next/**"
  ]
}

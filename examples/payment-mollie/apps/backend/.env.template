STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# Development runs the cache, event bus, and workflow engine in memory.
# Uncomment to use REDIS_URL in development too. Production always uses it.
# USE_REDIS=true
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DB_NAME=medusa_payment_mollie
DATABASE_URL=postgres://postgres@localhost/$DB_NAME
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=apps/storefront

# Medusa Integration Module (see https://gorgojs.com/medusa-integration-module)
INTEGRATION_ENCRYPTION_KEY=supersecret
# Mollie itself is configured under Settings -> Integrations in the Admin, so the API key does
# not belong in this file. The two SEED_ variables below only save filling it in by hand.

# SMTP configuration for transactional emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Storefront URL (used in email links)
STOREFRONT_URL=http://localhost:8000

# Shared secret sent as x-revalidate-secret to the storefront's /api/revalidate endpoint
# (must match REVALIDATE_SECRET in apps/storefront/.env.local)
REVALIDATE_SECRET=supersecret

# Fallback locale for emails when the order/customer carries none.
# Must be one of the locales in apps/backend/src/emails/i18n/messages (falls back to en).
STOREFRONT_DEFAULT_LOCALE=en

# Store branding used in email templates. These are the values the code falls
# back to when the variable is unset, repeated here so they are easy to change.
# STORE_NAME is also the sender name every email arrives under, so the inbox
# reads "Gorgo Medusa Store" instead of the bare SMTP_FROM address.
STORE_NAME="Gorgo Medusa Store"
STORE_EMAIL=hello@example.com

# Printed verbatim in the footer of every email, and left out of it when empty.
# Fill them in before going live rather than shipping a placeholder address to
# real customers. Many jurisdictions require a postal address in commercial mail.
# STORE_PHONE=+49 30 901820
# STORE_ADDRESS=Beispielstrasse 1, 10115 Berlin, Germany
STORE_PHONE=
STORE_ADDRESS=

# Set these to seed Mollie's settings automatically instead of filling them in from the Admin.
# Only read once, by the seed migration script, and never by the running backend.
# SEED_MOLLIE_API_KEY is the test API key (starts with test_) of a website profile, found under
# Developers -> API keys in the Mollie Dashboard.
# SEED_MOLLIE_WEBHOOK_URL is the public https address of this backend followed by
# /hooks/payment/mollie_mollie. Mollie cannot call localhost, so run `yarn dev:tunnel` and use the
# tunnel address, for example https://medusa-mollie.loca.lt/hooks/payment/mollie_mollie
SEED_MOLLIE_API_KEY=
SEED_MOLLIE_WEBHOOK_URL=

{
  "name": "@gorgo/license",
  "version": "1.0.0",
  "description": "License check for paid Gorgo plugins",
  "author": {
    "name": "Gorgo",
    "url": "https://gorgojs.com"
  },
  "license": "MIT",
  "bugs": "https://github.com/gorgojs/medusa-integrations/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/gorgojs/medusa-integrations",
    "directory": "packages/utils/license"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "yarn build && yalc publish",
    "test:unit": "jest --config jest.config.js"
  },
  "devDependencies": {
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.6.2",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}

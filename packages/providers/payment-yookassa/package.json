{
  "name": "@gorgo/medusa-payment-yookassa",
  "version": "2.0.2",
  "description": "YooKassa payment provider for Medusa",
  "files": [
    ".medusa/server",
    "index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gorgojs/medusa-integrations",
    "directory": "packages/providers/payment-yookassa"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./package.json": "./package.json",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-payment",
    "medusa-payment",
    "medusa-payment-yookassa",
    "yookassa",
    "yoomoney",
    "payment",
    "plugin"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "yarn predev && medusa plugin:develop",
    "predev": "medusa plugin:publish",
    "prepublishOnly": "medusa plugin:build",
    "test:unit": "jest --config jest.config.js"
  },
  "dependencies": {
    "@a2seven/yoo-checkout": "^1.1.4",
    "@gorgo/telemetry": "^1.4.0",
    "axios": "^1.9.0"
  },
  "devDependencies": {
    "@gorgo/medusa-integration": "^0.2.1",
    "@medusajs/admin-sdk": "^2.17.2",
    "@medusajs/cli": "^2.17.2",
    "@medusajs/framework": "^2.17.2",
    "@medusajs/icons": "^2.17.2",
    "@medusajs/medusa": "^2.17.2",
    "@medusajs/test-utils": "^2.17.2",
    "@medusajs/ui": "^4.0.25",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "msw": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@gorgo/medusa-integration": ">=0.1.5 <1.0.0",
    "@medusajs/admin-sdk": "^2.17.2",
    "@medusajs/cli": "^2.17.2",
    "@medusajs/framework": "^2.17.2",
    "@medusajs/medusa": "^2.17.2",
    "@medusajs/test-utils": "^2.17.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

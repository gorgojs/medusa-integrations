{
  "name": "@gorgo/medusa-feed-yandex",
  "version": "0.4.0",
  "description": "A Medusa plugin that generates a product feed in YML (Yandex Market Language) format",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gorgojs/medusa-integrations",
    "directory": "packages/providers/feed-yandex"
  },
  "files": [
    ".medusa/server",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "ecommerce",
    "yandex",
    "yandex market",
    "yml",
    "yml feed",
    "product feed",
    "export",
    "catalog export",
    "yandex yml",
    "marketplace",
    "Яндекс"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "yarn predev && medusa plugin:develop",
    "predev": "medusa plugin:publish",
    "prepublishOnly": "medusa plugin:build",
    "test:unit": "jest --config jest.config.js --passWithNoTests"
  },
  "dependencies": {
    "@gorgo/telemetry": "^1.4.1",
    "yandex-market-language": "^0.5.0"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.23.0",
    "@medusajs/cli": "^2.23.0",
    "@medusajs/framework": "^2.23.0",
    "@medusajs/icons": "^2.23.0",
    "@medusajs/medusa": "^2.23.0",
    "@medusajs/test-utils": "^2.23.0",
    "@medusajs/ui": "^4.3.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.13.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vite": "^8.3.8",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.23.0",
    "@medusajs/cli": "^2.23.0",
    "@medusajs/framework": "^2.23.0",
    "@medusajs/icons": "^2.23.0",
    "@medusajs/medusa": "^2.23.0",
    "@medusajs/test-utils": "^2.23.0",
    "@medusajs/ui": "^4.3.0",
    "date-fns": "^3.6.0",
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^2.4.2",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^6.30.4 || ^7.0.0",
    "zod": "^4.0.2"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}

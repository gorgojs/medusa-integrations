{
  "name": "@gorgo/medusa-integration-sandbox",
  "version": "0.0.0",
  "description": "Integration sandbox for developing Medusa integrations",
  "author": "Gorgo (https://gorgojs.com/)",
  "files": [
    ".medusa/server",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./package.json": "./package.json",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "keywords": [
    "medusa",
    "medusa-v2"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "yarn predev && medusa plugin:develop",
    "predev": "medusa plugin:publish",
    "prepublishOnly": "medusa plugin:build",
    "test:unit": "jest --config jest.config.js"
  },
  "dependencies": {
    "@gorgo/telemetry": "^1.0.0",
    "t-kassa-api": "^1.0.6"
  },
  "devDependencies": {
    "@gorgo/medusa-integration": "workspace:*",
    "@medusajs/admin-sdk": "^2.17.2",
    "@medusajs/cli": "^2.17.2",
    "@medusajs/framework": "^2.17.2",
    "@medusajs/icons": "^2.17.2",
    "@medusajs/medusa": "^2.17.2",
    "@medusajs/test-utils": "^2.17.2",
    "@medusajs/ui": "^4.0.8",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.13.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "msw": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@gorgo/medusa-integration": "*",
    "@medusajs/admin-sdk": "^2.17.2",
    "@medusajs/cli": "^2.17.2",
    "@medusajs/framework": "^2.17.2",
    "@medusajs/icons": "^2.17.2",
    "@medusajs/medusa": "^2.17.2",
    "@medusajs/test-utils": "^2.17.2",
    "@medusajs/ui": "^4.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}

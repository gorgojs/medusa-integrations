{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@gorgo/telemetry#build", "@gorgo/medusa-integration#build"],
      "outputs": [".medusa/**", "dist/**"],
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "@gorgo/telemetry#build": {
      "dependsOn": [],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "@gorgo/medusa-integration#build": {
      "dependsOn": ["@gorgo/telemetry#build"],
      "outputs": [".medusa/**"],
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "test:unit": {
      "dependsOn": ["^build", "@gorgo/telemetry#build", "@gorgo/medusa-integration#build"],
      "outputs": [],
      "inputs": ["src/**", "jest.config.*", "package.json"]
    },
    "test:integration:http": {
      "dependsOn": ["^build", "@gorgo/telemetry#build", "@gorgo/medusa-integration#build"],
      "outputs": []
    },
    "test:integration:modules": {
      "dependsOn": ["^build", "@gorgo/telemetry#build", "@gorgo/medusa-integration#build"],
      "outputs": []
    }
  },
  "globalDependencies": ["turbo.json"]
}
